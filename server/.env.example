# Backend Environment Variables
# Copy to .env for local development — NEVER commit .env to git

# ── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/starvis?appName=<appName>

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-min-64-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-different-from-access
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Gemini AI ─────────────────────────────────────────────────────────────
# STAYS ON SERVER — never expose to frontend
GEMINI_API_KEY=your-gemini-api-key

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@starvis.app

# ── File Uploads ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── Payments (Mock mode) ───────────────────────────────────────────────────
PAYMENT_MODE=mock
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx

# ── Frontend URL (for CORS + email links) ──────────────────────────────────
CLIENT_ORIGIN=http://localhost:8080
